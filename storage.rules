rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'OrdU20b9pBXfUYrh4z8hNR0F14B2' ||
        (
          request.auth.token.email is string &&
          (
            firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email)) ||
            firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower()))
          )
        )
      );
    }
    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf';
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isValidSize() {
      return request.resource.size < 5 * 1024 * 1024; // 5MB
    }

    // السماح بقائمة الفولدر (list) — للاسترداد التلقائي للحسابات القديمة
    // اللي صورتها مرفوعة في Storage لكن الـURL مش محفوظ في Firestore.
    match /doctor-verification/{userId} {
      allow list: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    match /doctor-verification/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId
                    && isValidSize() && isImageOrPdf();
      allow update, delete: if isAdmin();
    }
    // Legacy path used by uploadVerificationDoc in storageService.ts
    match /verification_docs/{userId} {
      allow list: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    match /verification_docs/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId
                    && isValidSize() && isImageOrPdf();
      allow update, delete: if isAdmin();
    }
    match /profile_images/{imageId} {
      allow read: if true;
      // المستخدم العادي: ملفاته باسم بيبدأ بـUID بتاعه. الأدمن: مسموح يرفع
      // أي ملف هنا (لمساعدة طبيب في صور إعلانه)، نفس الحدّ في الحجم/النوع.
      allow write: if request.auth != null
                   && (imageId.matches(request.auth.uid + '.*') || isAdmin())
                   && (request.resource == null || (isValidSize() && isImage()));
    }
    // Path used by uploadProfilePhoto / uploadBase64Photo in storageService.ts
    match /users/{userId}/profile/{fileName} {
      allow read: if true;
      // الطبيب: يعدّل صور بروفايله/تصميم روشتته. الأدمن: مسموح يرفع/يعدّل
      // عند مساعدة طبيب في تصميم الروشتة (شعار، خلفيات).
      allow write: if request.auth != null
                   && (request.auth.uid == userId || isAdmin())
                   && (request.resource == null || (isValidSize() && isImage()));
    }
    function hasReservedPatientImage(userId, patientFileId, fileName) {
      let metadata = request.resource.metadata;
      let imageId = 'patientImageId' in metadata ? metadata.patientImageId : '__missing__';
      let reservation = firestore.get(/databases/(default)/documents/users/$(userId)/patientImages/$(imageId));
      return imageId is string &&
        reservation.data.patientFileId == patientFileId &&
        reservation.data.status == 'uploading' &&
        reservation.data.storagePath == 'patient-images/' + userId + '/' + patientFileId + '/' + fileName;
    }

    // صور ملفات المرضى: خاصة بالطبيب صاحب الحساب فقط، وبعد ضغطها على الجهاز.
    // لا نسمح بالتحديث فوق ملف قائم؛ كل صورة لها object مستقل لتفادي الكتابة المتزامنة.
    match /patient-images/{userId}/{patientFileId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && hasReservedPatientImage(userId, patientFileId, fileName)
                    && isValidSize()
                    && (
                      request.resource.contentType == 'image/jpeg' ||
                      request.resource.contentType == 'image/png' ||
                      request.resource.contentType == 'image/webp'
                    );
      allow update: if false;
      allow delete: if false;
    }

    match /homepage-banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || (isValidSize() && isImage()));
    }
  }
}
