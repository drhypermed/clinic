VITE_VAPID_KEY=PLACEHOLDER
VITE_RECAPTCHA_SITE_KEY=PLACEHOLDER

# Optional: Sentry DSN for real-time error alerting. If not set, only Firestore errorLogs is used.
# Sign up at sentry.io (5k events/month free) → create React project → paste DSN here.
VITE_SENTRY_DSN=

# Optional: base URL/template for Storage/Hosting guideline text files.
# Hosting example: https://example.web.app/guidelines-static
# Firebase Storage template example: https://firebasestorage.googleapis.com/v0/b/YOUR_BUCKET/o/guidelines-static%2F{path}?alt=media&token=TOKEN
VITE_GUIDELINE_STATIC_BASE_URL=
