# SMTP settings for OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# OTP pepper - REQUIRED in production (use a strong random string)

# Root admin credentials - REQUIRED
ROOT_ADMIN_UID=your-firebase-admin-uid-here
ROOT_ADMIN_EMAIL=your-admin-email@example.com

# App Check enforcement (default: true on all)
# Set to 'false' only if you need to debug or if App Check breaks a specific flow.
# ENFORCE_APP_CHECK=true                   # All admin/base functions
# GEMINI_ENFORCE_APP_CHECK=true            # Gemini AI calls
# ACCOUNT_CONTROLS_ENFORCE_APP_CHECK=true  # Quota consumers (consume*Quota, getAccountTypeControls)

# Optional hard Gemini cost backstops per doctor/month. Defaults are defined in
# smartRxDefaults.js (free=$0.10, premium=$0.50, plus=$0, pro_max=$1.00).
# GEMINI_MONTHLY_BUDGET_USD_FREE=0.10
# GEMINI_MONTHLY_BUDGET_USD_PREMIUM=0.50
# GEMINI_MONTHLY_BUDGET_USD_PLUS=0
# GEMINI_MONTHLY_BUDGET_USD_PRO_MAX=1.00
# GEMINI_MAX_OUTPUT_TOKENS=8192
# Conservative Gemini 2.5 Search grounding charge after the shared free quota.
# GEMINI_GOOGLE_SEARCH_REQUEST_USD=0.035

# Optional: Custom bucket for Firestore backups. If not set, uses the project's
# default storage bucket. Clinical/account data is exported daily and kept 14 days;
# a full database export runs weekly and is kept 56 days.
# FIRESTORE_BACKUP_BUCKET=your-custom-bucket-name

# Guideline search rollout:
# firestore = current Firestore index, shadow = compare Storage silently,
# static = use Storage for confidently routed searches and Firestore as fallback.
GUIDELINE_SEARCH_BACKEND=firestore
GUIDELINE_STATIC_SEARCH_ROOT=guidelines-search/v1
GUIDELINE_STATIC_SEARCH_SHADOW_PERCENT=100
GUIDELINE_STATIC_BOOK_CACHE_MAX=60
